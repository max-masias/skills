# Archivos binarios: Git no debe tocar sus finales de línea (en Windows, core.autocrlf los cambiaría
# y podría dañarlos al descargarlos, p. ej. un PDF sin bytes nulos al inicio que Git cree texto).
*.pdf   binary
*.docx  binary
*.doc   binary
*.xlsx  binary
*.xls   binary
*.pptx  binary
*.ppt   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
