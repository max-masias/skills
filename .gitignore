# --- No subir al repositorio ---

# Código fuente de clientes y compilados (confidencial y muy pesado)
Zips/

# Dependencias y archivos temporales
node_modules/
__pycache__/
*.pyc
~$*
.~lock*
desktop.ini
Thumbs.db
.DS_Store

# Material antiguo archivado durante la reorganización
_archivo/
aplicar_orden.ps1

# Configuración personal de Claude Code (permisos y rutas de este equipo)
.claude/settings.local.json

# Archivos de trabajo intermedios de las skills
Generador_informes_MD/Informe_generado/_trabajo/

# Registro local de la reorganización
REORGANIZACION.txt

# Claves personales (el .env de parsear-documento lo crea su configurador)
.env

# Registro local de consumo de créditos de LlamaParse (es de cada cuenta)
.llamaparse/

# Documentos de parsear-documento (pueden ser de clientes): solo se suben las carpetas vacías
.claude/skills/parsear-documento/Documentos_entrada/*
!.claude/skills/parsear-documento/Documentos_entrada/.gitkeep
.claude/skills/parsear-documento/Documentos_parseados/*
!.claude/skills/parsear-documento/Documentos_parseados/.gitkeep

# Archivos de archivo-a-markdown (pueden ser de clientes): solo se suben las carpetas vacías
.claude/skills/archivo-a-markdown/Archivos_entrada/*
!.claude/skills/archivo-a-markdown/Archivos_entrada/.gitkeep
.claude/skills/archivo-a-markdown/Markdown_generado/*
!.claude/skills/archivo-a-markdown/Markdown_generado/.gitkeep
